# Copy to .env and fill in real values: cp .env.sample .env
# Used by docker compose and local dev (see README).

VUE_APP_PACKETFENCE_USERNAME=apiuser
VUE_APP_PACKETFENCE_PASSWORD=your-api-password
VUE_APP_PACKETFENCE_API_URL=https://172.22.10.176:1443/api/v1   

# Optional: set to "true" when using a self-signed or private CA TLS cert (matches Dockerfile default).
# PACKETFENCE_IGNORE_SSL=true

# Pangolin/Newt tunnel. From Pangolin: Sites -> Add Site -> Newt.
# NEWT_SECRET is shown once; if lost, rotate the site.
NEWT_ID=
NEWT_SECRET=
PANGOLIN_ENDPOINT=https://pangolin.mckinnonsc.vic.edu.au